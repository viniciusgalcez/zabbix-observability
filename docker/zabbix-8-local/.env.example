# Copie para .env e ajuste antes de subir o stack.
# NUNCA commitar o .env real (ja esta no .gitignore).

POSTGRES_USER=zabbix
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=zabbix

ZBX_SERVER_HOST=zabbix-server

