              {"color": "yellow", "value": 4},
              {"color": "red", "value": 5}
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {"text": "Outro", "color": "grey"},
                "2": {"text": "Desconhecido", "color": "blue"},
