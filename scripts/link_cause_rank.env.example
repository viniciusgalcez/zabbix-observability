# Exemplo de env para o servidor Zabbix — NÃO versionar com token real.
# Copiar para /etc/zabbix/link_cause_rank.env (chmod 600, dono root/zabbix)
#
# ZABBIX_URL=http://127.0.0.1/api_jsonrpc.php
# ZABBIX_TOKEN=
# ZABBIX_RANK_PYTHON=/usr/bin/python3

ZABBIX_URL=http://127.0.0.1/api_jsonrpc.php
ZABBIX_TOKEN=REPLACE_ME
ZABBIX_RANK_PYTHON=/usr/bin/python3
